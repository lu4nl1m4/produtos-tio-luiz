rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção de produtos: qualquer um pode ler, só admin autenticado escreve.
    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Coleção de categorias: qualquer um pode ler, só admin autenticado escreve.
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cards da home (preview na index.html): leitura pública, escrita só autenticado.
    match /home_cards/{cardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Coleção de receitas: leitura pública, escrita só autenticado.
    match /receitas/{receitaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Banners das páginas públicas (hero): leitura pública, escrita só autenticado.
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Mensagens dos formulários públicos (contato + revendedor).
    // - Leitura/update/delete: só admin autenticado.
    // - Create: público (qualquer um pode submeter), com validação de campos.
    match /mensagens/{mensagemId} {
      allow read, update, delete: if request.auth != null;
      allow create: if
        request.resource.data.tipo in ["contato", "revendedor"] &&
        request.resource.data.lida == false &&
        request.resource.data.size() < 25;
    }

    // Negar qualquer outro caminho por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção de produtos: qualquer um pode ler, só admin autenticado escreve.
    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Coleção de categorias: qualquer um pode ler, só admin autenticado escreve.
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cards da home (preview na index.html): leitura pública, escrita só autenticado.
    match /home_cards/{cardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Negar qualquer outro caminho por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# Normaliza quebras de linha (LF no repositório)
* text=auto eol=lf

# Arquivos de texto — força LF e encoding UTF-8
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf

# Arquivos binários — não tocar
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.pdf   binary
*.zip   binary

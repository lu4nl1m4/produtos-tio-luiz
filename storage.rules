rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Imagens de produtos: leitura pública, upload só para admin autenticado.
    match /produtos/{imagem} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Negar qualquer outro caminho por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
